<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mypageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 영역 -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="122dp"
            android:layout_height="44dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/menu"
            android:tint="#555555" />
    </LinearLayout>

    <!-- 메인 콘텐츠 -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- 제목 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvMypageTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="마이페이지"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- 학생 프로필 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/studentProfileCard"
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginBottom="12dp"
            android:visibility="visible"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivStudentProfile"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_profile_circle"
                    android:padding="11dp"
                    android:src="@drawable/student"
                    android:tint="#9C9C9C" />

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="홍길동 학생"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStudentMajor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:text="소프트웨어학과"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStudentInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:text="24231880 / 3학년"
                    android:textColor="#555555"
                    android:textSize="12sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 교수 프로필 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/professorProfileCard"
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivProfessorProfile"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_profile_circle"
                    android:padding="11dp"
                    android:src="@drawable/professor"
                    android:tint="#9C9C9C" />

                <TextView
                    android:id="@+id/tvProfessorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="홍길동 교수"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfessorMajor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:text="소프트웨어학과"
                    android:textColor="#555555"
                    android:textSize="12sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 내 시간표 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/myScheduleCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:id="@+id/timeTableFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="30dp"
                android:paddingTop="12dp"
                android:paddingEnd="28dp"
                android:paddingBottom="12dp">

                <!-- 시간표 기본 그리드 -->
                <TableLayout
                    android:id="@+id/tableScheduleGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:stretchColumns="1,2,3,4,5">

                    <!-- 요일 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="22dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="월"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="화"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="수"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="목"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="금"
                            android:textColor="#777777"
                            android:textSize="10sp" />
                    </TableRow>

                    <!-- 9시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="52dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="9"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 10시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="52dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="10"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 11시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="52dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="11"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 12시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="52dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="12"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 1시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="52dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="1"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 2시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="52dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="2"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>

                    <!-- 3시 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="52dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="match_parent"
                            android:gravity="top|center_horizontal"
                            android:text="3"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF" />
                    </TableRow>
                </TableLayout>

                <!-- 가로선 오버레이 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical">

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EDF3" />
                    <View android:layout_width="match_parent" android:layout_height="51dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EDF3" />
                    <View android:layout_width="match_parent" android:layout_height="51dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EDF3" />
                    <View android:layout_width="match_parent" android:layout_height="51dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EDF3" />
                    <View android:layout_width="match_parent" android:layout_height="51dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EDF3" />
                    <View android:layout_width="match_parent" android:layout_height="51dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EDF3" />
                    <View android:layout_width="match_parent" android:layout_height="51dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EDF3" />
                </LinearLayout>

                <!-- 세로선 오버레이 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="56dp"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E8EDF3" />
                    <View android:layout_width="57dp" android:layout_height="match_parent" />
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E8EDF3" />
                    <View android:layout_width="57dp" android:layout_height="match_parent" />
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E8EDF3" />
                    <View android:layout_width="57dp" android:layout_height="match_parent" />
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E8EDF3" />
                    <View android:layout_width="57dp" android:layout_height="match_parent" />
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E8EDF3" />
                    <View android:layout_width="57dp" android:layout_height="match_parent" />
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E8EDF3" />
                </LinearLayout>

                <!-- 백엔드에서 받아온 내 시간표 블록을 올릴 영역 -->
                <FrameLayout
                    android:id="@+id/myScheduleBlockLayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="26dp"
                    android:paddingTop="22dp">

                    <!-- 미리보기용 시간표 블록: 나중에 Kotlin에서 removeAllViews() 후 백엔드 데이터로 다시 그림 -->

                    <TextView
                        android:id="@+id/blockDataStructureTue"
                        android:layout_width="58dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="58dp"
                        android:layout_marginTop="52dp"
                        android:background="#8FA2C7"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:padding="3dp"
                        android:text="자료구조\n및 실습 (\n영어강의)"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/blockDataStructureThu"
                        android:layout_width="58dp"
                        android:layout_height="104dp"
                        android:layout_marginStart="174dp"
                        android:layout_marginTop="52dp"
                        android:background="#8FA2C7"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:padding="3dp"
                        android:text="자료구조\n및 실습 (\n영어강의)\nAI관-511"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/blockSoftwareFri"
                        android:layout_width="58dp"
                        android:layout_height="156dp"
                        android:layout_marginStart="232dp"
                        android:layout_marginTop="52dp"
                        android:background="#79B2B8"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:padding="3dp"
                        android:text="소프트웨\n어공학 (신\n기술화상\n강의)\n화상강의\n의실 (가상)"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/blockMobileTue"
                        android:layout_width="58dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="58dp"
                        android:layout_marginTop="260dp"
                        android:background="#B9AAA5"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:padding="3dp"
                        android:text="모바일프로\n그래밍 (영\n어강의)"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/blockMobileThu"
                        android:layout_width="58dp"
                        android:layout_height="104dp"
                        android:layout_marginStart="174dp"
                        android:layout_marginTop="208dp"
                        android:background="#B9AAA5"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:padding="3dp"
                        android:text="모바일프로\n그래밍 (영\n어강의)\nAI관-301"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- 하단 메뉴 -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/primarybase"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBottomHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/home"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/retry"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/bell"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/calendar"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/back"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>